# -------------------------------------------------------------
# ZestMart PK — Production & Development Environment Configuration
# -------------------------------------------------------------

# Application URLs
APP_URL="http://localhost:3000"
SELLER_PORTAL_URL="http://seller.localhost:3000"
ADMIN_PORTAL_URL="http://admin.localhost:3000"
NODE_ENV="development"
PORT=3000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://zestmart_user:zestmart_secure_pass@localhost:5432/zestmart_pk?schema=public"

# Authentication & JWT
JWT_SECRET="zestmart_super_secure_jwt_token_2026_pk"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="zestmart_express_session_secret_key"
OTP_EXPIRY_SECONDS=300

# Pakistani Payment Gateways (Sandbox / Live)
JAZZCASH_MERCHANT_ID="MC12345"
JAZZCASH_PASSWORD="jazz_sandbox_password"
JAZZCASH_INTEGERITY_SALT="jazz_salt_key_12345"
JAZZCASH_RETURN_URL="http://localhost:3000/api/payments/jazzcash/callback"

EASYPAISA_STORE_ID="12345"
EASYPAISA_HASH_KEY="easypaisa_sandbox_hash"
EASYPAISA_POST_BACK_URL="http://localhost:3000/api/payments/easypaisa/callback"

RAAST_BANK_ACCOUNT_TITLE="ZestMart PK (Pvt) Ltd"
RAAST_BANK_IBAN="PK64MEZN0001029384729102"
RAAST_BANK_NAME="Meezan Bank Ltd"

# Pakistani Courier Logistics (TCS, Leopards, Trax)
TCS_API_KEY="tcs_express_sandbox_key"
TCS_COST_CENTER_CODE="KHI-0042"
TCS_ACCOUNT_NUMBER="104928"

LEOPARDS_API_KEY="leopards_sandbox_api_key"
LEOPARDS_API_PASSWORD="leopards_secret"

TRAX_API_KEY="trax_express_api_token"

# FBR Digital Invoicing & POS Integration
FBR_POS_ENDPOINT="https://fbr.gov.pk/api/pos/v1/invoice"
FBR_POS_MACHINE_ID="ZM-POS-001"
FBR_NTN="7281904-2"

# Object Storage (Local Provider / AWS S3 / Cloudflare R2)
STORAGE_PROVIDER="local" # "local" | "s3" | "r2"
S3_BUCKET_NAME="zestmart-cdn-assets"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID="AWS_ACCESS_KEY_MOCK"
S3_SECRET_ACCESS_KEY="AWS_SECRET_KEY_MOCK"

# SMS / OTP Provider (Provider-Agnostic Interface)
SMS_PROVIDER="mock" # "mock" | "zong" | "jazz" | "twilio"
SMS_API_KEY="mock_sms_gateway_key"

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN="http://localhost:3000"
